{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "regions": [
    "cle1"
  ],
  "installCommand": "npx --yes npm@10.9.7 ci",
  "buildCommand": "npm run typecheck",
  "outputDirectory": "public",
  "functions": {
    "api/service.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/internal/reminders",
      "destination": "/api/service?route=/internal/reminders"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/service?route=/auth/:path*"
    },
    {
      "source": "/account",
      "destination": "/api/service?route=/account"
    },
    {
      "source": "/content-reports",
      "destination": "/api/service?route=/content-reports"
    },
    {
      "source": "/health",
      "destination": "/api/service?route=/health"
    },
    {
      "source": "/status",
      "destination": "/api/service?route=/status"
    },
    {
      "source": "/dashboard",
      "destination": "/api/service?route=/dashboard"
    },
    {
      "source": "/diagnostics",
      "destination": "/api/service?route=/diagnostics"
    },
    {
      "source": "/diagnostics/ai",
      "destination": "/api/service?route=/diagnostics/ai"
    },
    {
      "source": "/diagnostics/session",
      "destination": "/api/service?route=/diagnostics/session"
    },
    {
      "source": "/progress",
      "destination": "/api/service?route=/progress"
    },
    {
      "source": "/sessions",
      "destination": "/api/service?route=/sessions"
    },
    {
      "source": "/sessions/:path*",
      "destination": "/api/service?route=/sessions/:path*"
    },
    {
      "source": "/speech/:path*",
      "destination": "/api/service?route=/speech/:path*"
    },
    {
      "source": "/learner",
      "destination": "/api/service?route=/learner"
    },
    {
      "source": "/rewards",
      "destination": "/api/service?route=/rewards"
    },
    {
      "source": "/rewards/:path*",
      "destination": "/api/service?route=/rewards/:path*"
    },
    {
      "source": "/friends",
      "destination": "/api/service?route=/friends"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/service?route=/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style 'unsafe-inline'; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/; media-src 'self' blob:; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
