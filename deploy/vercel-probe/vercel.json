{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "regions": ["cle1"],
  "installCommand": "npx --yes npm@10.9.7 ci",
  "buildCommand": "npm run typecheck",
  "outputDirectory": "public",
  "functions": {
    "api/probe.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/probe?endpoint=health" },
    { "source": "/diagnostics", "destination": "/api/probe?endpoint=diagnostics" },
    { "source": "/diagnostics/ai", "destination": "/api/probe?endpoint=ai" },
    { "source": "/diagnostics/session", "destination": "/api/probe?endpoint=session" }
  ]
}
