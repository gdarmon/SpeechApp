{
  "name": "fala-speech-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0 <23" },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "netlify dev",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark.mjs"
  },
  "dependencies": {
    "@netlify/functions": "6.0.0",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "overrides": { "sharp": "0.35.4" },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.19.15",
    "netlify-cli": "27.8.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
