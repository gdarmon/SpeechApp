# Set these in Netlify > Environment variables, Functions scope, Production context.
# Secrets are never built into the Android app or published site.
# Google OAuth WEB client ID, not the Android client ID. This ID is public.
GOOGLE_WEB_CLIENT_ID=
# Optional operator diagnostics/legacy data access; random 32+ characters. Never give this to app users.
FALA_TOKEN=
# Optional AI request allowances per rolling day; 0 disables a daily allowance.
# Production can disable these while keeping per-account flood protection.
FALA_DAILY_USER_LIMIT=200
FALA_DAILY_APP_LIMIT=2000
DATABASE_URL=
# Paid conversation route and an explicitly authorized backup.
# Each route has its own credential; slow requests may charge both providers.
FALA_AI_PROVIDER=openai
FALA_AI_FALLBACK_PROVIDER=groq
FALA_AI_HEDGE_MS=1200
FALA_TRANSCRIPTION_PROVIDER=openai
FALA_GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# OpenAI conversation and natural Brazilian voice playback credential.
FALA_OPENAI_API_KEY=
FALA_OPENAI_MODEL=gpt-5.6-luna
# Legacy compatible settings. A Groq endpoint/key here is also accepted
# when GROQ_API_KEY is empty. FALA_AI_PROVIDER selects conversation routing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
FALA_DEMO=false

# Shared primary/backup/repair deadline, 5,000–15,000 ms.
AI_TIMEOUT_MS=8000
# Optional: a database root certificate; \n escapes in the value are expanded.
DATABASE_CA_CERT=

# Local loopback PostgreSQL only. Rejected for hosted databases and Netlify.
FALA_LOCAL_DATABASE=false

# Local benchmark only; do not put tokens in this URL.
FALA_URL=

# Optional Web Push reminders. Generate one pair with web-push; keep the private key server-only.
FALA_VAPID_PUBLIC_KEY=
FALA_VAPID_PRIVATE_KEY=
